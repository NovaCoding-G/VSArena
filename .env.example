# Assumption: copy to `.env.local` and fill from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Official leaderboard writes: harness sends this as header x-vsarena-ingest (min 16 chars).
HARNESS_INGEST_SECRET=
# Next app the harness POSTs results to.
VSARENA_APP_URL=http://127.0.0.1:3000
# SDK live clients (production hosted harness, or local npm run harness)
# VSARENA_HARNESS_URL=wss://vsarena-harness.onrender.com
# Browser spectator page /live uses the same host + /spectate (override base):
# NEXT_PUBLIC_HARNESS_WS_URL=wss://vsarena-harness.onrender.com
# HARNESS_PORT=8787
# Canonical public origin (OG, sitemap). On Vercel, VERCEL_URL is used if this is empty.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shown on /privacy and /terms. Public handle only — not a civil name.
NEXT_PUBLIC_LEGAL_CONTROLLER=NovaCoding-G
NEXT_PUBLIC_LEGAL_EMAIL=novacodingg@gmail.com
